	title = {Spatial and seasonal foraging patterns drive diet differences among north Pacific resident killer whale populations},
	author = {Van Cise, Amy M. and Hanson, M. Bradley and Emmons, Candice and Olsen, Dan and Matkin, Craig O. and Wells, Abigail H. and Parsons, Kim M.},
